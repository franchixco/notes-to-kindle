{
	"name": "send-to-kindle",
	"version": "0.1.0",
	"description": "Convert notes to EPUB locally and send them to Amazon Kindle using an unofficial desktop integration.",
	"main": "main.js",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bunx tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs",
		"lint": "bunx eslint .",
		"test": "bun test",
		"test:typecheck": "bunx tsc -noEmit -skipLibCheck -p tsconfig.test.json"
	},
	"keywords": [
		"obsidian",
		"kindle",
		"epub",
		"send-to-kindle",
		"stk",
		"amazon"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.20.1",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"obsidian": "latest",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"marked": "^18.0.9"
	}
}
