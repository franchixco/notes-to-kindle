{
	"name": "send-to-kindle",
	"version": "0.1.0",
	"description": "Convert notes to EPUB locally and send them to Amazon Kindle using an unofficial desktop integration.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "bun test",
		"test:typecheck": "tsc -noEmit -skipLibCheck -p tsconfig.test.json"
	},
	"keywords": [
		"obsidian",
		"kindle",
		"epub",
		"send-to-kindle",
		"stk",
		"amazon"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"jszip": "^3.10.1",
		"marked": "^18.0.5"
	}
}
